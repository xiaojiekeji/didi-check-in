<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        注意：v1.2 起改为「截图 + OCR 文字识别 + 坐标点击」，下面的关键词是拿 OCR 结果做包含匹配，
        页面改版时只需要改这里，不用改代码。单字符（× ✕ X）按完全相等匹配，避免误点。
    -->

    <!-- 顶部「车主」入口 -->
    <string-array name="kw_owner">
        <item>车主</item>
    </string-array>

    <!-- 车主页里的「滴滴充电 / 小桔充电」入口 -->
    <string-array name="kw_charge">
        <item>滴滴充电</item>
        <item>小桔充电</item>
        <item>充电</item>
    </string-array>

    <!-- 底部导航「我的」 -->
    <string-array name="kw_mine">
        <item>我的</item>
        <item>个人中心</item>
    </string-array>

    <!-- 「会员中心」入口 -->
    <string-array name="kw_member">
        <item>会员中心</item>
        <item>会员</item>
    </string-array>

    <!-- 签到按钮文案 -->
    <string-array name="kw_checkin">
        <item>立即签到</item>
        <item>每日签到</item>
        <item>签到有礼</item>
        <item>去签到</item>
        <item>签到</item>
    </string-array>

    <!-- 已经签过的判定文案（优先于签到按钮判断） -->
    <string-array name="kw_signed">
        <item>今日已签到</item>
        <item>已签到</item>
        <item>明天再来</item>
        <item>明日再来</item>
        <item>已领取</item>
    </string-array>

    <!-- 签到成功的判定文案（只认明确的成功字样，避免被首页广告的「恭喜/获得」误判） -->
    <string-array name="kw_success">
        <item>签到成功</item>
        <item>领取成功</item>
        <item>签到完成</item>
        <item>已签到</item>
        <item>明天再来</item>
    </string-array>

    <!-- 弹窗上「一律点关闭」的按钮文案 -->
    <string-array name="kw_close">
        <item>关闭</item>
        <item>×</item>
        <item>✕</item>
        <item>X</item>
        <item>知道了</item>
        <item>我知道了</item>
        <item>取消</item>
        <item>跳过</item>
        <item>以后再说</item>
        <item>暂不</item>
        <item>稍后</item>
        <item>不再提示</item>
        <item>放弃</item>
    </string-array>

    <!-- 兜底：如果弹窗只给「同意」才能继续，这些文案在最后才会被点 -->
    <string-array name="kw_confirm">
        <item>同意并继续</item>
        <item>同意</item>
        <item>我已知晓</item>
    </string-array>

    <!--
        弹窗特征文案：只有屏幕上出现以下任意一个词，才认为当前有弹窗、才会去找关闭按钮。
        正常页面（首页/充电页/我的页）不会有这些词，因此不会出现「见 × 就点」的乱跳。
    -->
    <string-array name="kw_popup">
        <item>同意</item>
        <item>允许</item>
        <item>我知道了</item>
        <item>知道了</item>
        <item>温馨提示</item>
        <item>隐私政策</item>
        <item>用户协议</item>
        <item>授权</item>
        <item>开启通知</item>
        <item>定位权限</item>
        <item>立即更新</item>
        <item>版本更新</item>
        <item>以后再说</item>
        <item>暂不</item>
        <item>跳过</item>
        <item>取消</item>
    </string-array>
</resources>
