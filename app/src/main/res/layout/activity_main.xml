<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="滴滴充电 · 每日自动签到"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="全部在本机运行，不联网上传数据。"
            android:textSize="12sp"
            android:textColor="#6B7280" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="① 运行环境"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="无障碍服务：未开启"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="去开启无障碍服务" />

        <TextView
            android:id="@+id/statusBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="电池优化：未知"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="加入电池优化白名单" />

        <TextView
            android:id="@+id/statusAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="精确闹钟：未知"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAlarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="允许精确闹钟" />

        <Button
            android:id="@+id/btnNotify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="允许通知" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="② 参数配置"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="每日执行时间（会在此基础上随机偏移 0~30 分钟）"
            android:textSize="13sp" />

        <TimePicker
            android:id="@+id/timePicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:timePickerMode="spinner" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="目标 App 包名"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="com.sdu.didi.psnger"
            android:inputType="text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="启用每日自动签到（关闭后只保留手动测试）" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存配置并重新排程" />

        <Button
            android:id="@+id/btnRunNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即测试执行一次" />

        <TextView
            android:id="@+id/tvNextRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="下次执行：—"
            android:textSize="12sp"
            android:textColor="#6B7280" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="③ 运行日志"
            android:textStyle="bold"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRefreshLog"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="刷新" />

            <Button
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="清空" />

            <Button
                android:id="@+id/btnShot"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="最近截图" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="6dp"
            android:background="#F4F6FA"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textIsSelectable="true"
                android:typeface="monospace" />
        </ScrollView>

    </LinearLayout>
</ScrollView>
